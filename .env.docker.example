# Copy to .env before docker compose up
# cp .env.docker.example .env

# IMPORTANT: Set a strong secret in production
JWT_SECRET=change_me_in_env

# Backend auth lock settings
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Host ports
# Port 4000 is currently used by local node in this workspace.
# Change BACKEND_HOST_PORT to 4001 if needed.
BACKEND_HOST_PORT=4000

# Port 5173 is currently used by local node in this workspace.
# Use 8080 for containerized frontend (default in compose).
FRONTEND_HOST_PORT=8080

# Default: use compose MongoDB service (enable profile with-db)
MONGO_URI=mongodb://vtracker-db:27017/verbrauch

# Optional: reuse existing MongoDB container on host (detected on 27018)
# MONGO_URI=mongodb://host.docker.internal:27018/verbrauch

# Frontend -> backend upstream (inside docker network)
BACKEND_UPSTREAM=vtracker-backend:4000

# Network integration
# If you already have an external network (e.g. reverse proxy), set:
# VTRACKER_NETWORK_EXTERNAL=true
# VTRACKER_NETWORK_NAME=your-existing-network
VTRACKER_NETWORK_EXTERNAL=false
VTRACKER_NETWORK_NAME=vtracker-network
